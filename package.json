{
  "name": "sari-wave-challange",
  "version": "3.0.0",
  "private": true,
  "description": "2.500 parkur, kazanılabilir 12 karakter, kariyer ve Grief finali.",
  "scripts": {
    "start": "node server.mjs 5174",
    "test": "node --test tests/*.test.cjs",
    "check": "node --check engine.js && node --check game.js && node --check server.mjs && node --check desktop.cjs && node --check build-windows.cjs && node --check music.js && node --check save.js && node --check build-common.cjs && node --check build-mac.cjs && node --check build-linux.cjs && node --check create-icons.cjs && node --check progression.js && node --check library.js",
    "desktop": "electron .",
    "build:win": "node build-windows.cjs",
    "build:mac": "node build-mac.cjs",
    "build:linux": "node build-linux.cjs",
    "icons:mac": "node create-icons.cjs"
  },
  "main": "desktop.cjs",
  "author": "Wave Games",
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.wavegames.sari",
    "productName": "Sarı Wave Challange",
    "directories": {
      "output": "paket"
    },
    "files": [
      "index.html",
      "style.css",
      "engine.js",
      "game.js",
      "icon.svg",
      "desktop.cjs",
      "music.js",
      "save.js",
      "build/icon.png",
      "progression.js",
      "library.js"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false,
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Sarı Wave Challange.exe"
    },
    "toolsets": {
      "nsis": "1.2.1"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "category": "public.app-category.games",
      "icon": "build/icon.icns",
      "artifactName": "${productName}-mac-${arch}.dmg"
    },
    "dmg": {
      "format": "UDZO",
      "title": "${productName} ${version}",
      "writeUpdateInfo": false,
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": [
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "icon": "build/icon.png",
      "executableName": "sari-wave-challange",
      "artifactName": "${productName}-linux-${arch}.tar.gz"
    }
  }
}
